+// H2/H4: escape user-controlled values before they go into email HTML.
+// Email clients sandbox scripts, but a crafted clientName/url could still
+// produce misleading markup or a hostile link to Eric. Neutralize both.
+function escHtmlSrv(s: unknown): string {
+  return String(s == null ? '' : s).replace(/[&<>"']/g, (m) => (
+    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] as string
+  ));
+}
+// Only allow http(s) links; anything else (javascript:, data:) becomes '#'.
+function safeUrl(u: unknown): string {
+  const s = String(u == null ? '' : u).trim();
+  return /^https?:\/\//i.test(s) ? escHtmlSrv(s) : '#';
+}
